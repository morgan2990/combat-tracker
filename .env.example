MONGODB_URI=mongodb://user:password@host:27017/combatapp?authSource=admin
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pdfs
TYPESENSE_URL=http://host:8108
TYPESENSE_API_KEY=
# false for local/LAN HTTP testing so the session cookie isn't rejected;
# leave unset (defaults to true) for real deployments behind HTTPS.
COOKIE_SECURE=false
PORT=8080

# Used by docker-compose.yml to configure the mongo/minio/typesense/cloudflared
# containers themselves (separate from the app's own MONGODB_URI etc. above,
# which point the app AT those containers by service name — e.g.
# mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@mongo:27017/combatapp?authSource=admin).
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=

# Local 5etools repo checkouts, used only by scripts/run-scrubber.ps1 to
# default the --source path per edition so it doesn't have to be typed
# on every run.
SCRUBBER_SOURCE_5E=
SCRUBBER_SOURCE_5_5E=
